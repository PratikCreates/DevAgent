# Database Configuration
DATABASE_URL="mysql+mysqlconnector://username:password@host:port/database_name"

# LLM Provider: "kimi", "openrouter", "ollama", or "huggingface"
LLM_PROVIDER="kimi"

# LLM Model to use
LLM_MODEL="moonshot-v1-8k" # Example for kimi

# Moonshot AI (Kimi) API Key
KIMI_API_KEY="sk-your-moonshot-api-key-here"

# OpenRouter API Key
OPENROUTER_API_KEY="sk-or-your-openrouter-api-key-here"

# Ollama Configuration
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_API_KEY="ollama" # Default, change if needed

# Hugging Face API Key
HUGGINGFACE_API_KEY="hf_your-huggingface-api-key-here"